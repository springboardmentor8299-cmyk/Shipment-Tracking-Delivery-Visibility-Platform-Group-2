    {
      "name": "Proof of Delivery (POD)",
      "item": [
        {
          "name": "Get POD Record",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/api/pod/1", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "pod", "1"] }
          }
        },
        {
          "name": "Capture Digital Signature",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"signatureData\": \"data:image/svg+xml;utf8,<svg width='200' height='80'><path d='M10 40 Q 50 10 90 40' stroke='blue'/></svg>\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/pod/1/signature", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "pod", "1", "signature"] }
          }
        },
        {
          "name": "Upload Delivery Photo",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"photoUrl\": \"https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=600\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/pod/1/photo", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "pod", "1", "photo"] }
          }
        },
        {
          "name": "Confirm Delivery (Operator POD)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"signatureData\": \"data:image/png;base64,demo\",\n  \"photoUrls\": \"https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d\",\n  \"recipientName\": \"Theerthana V\",\n  \"deliveryAgentId\": 501,\n  \"geoLat\": 12.9352,\n  \"geoLng\": 77.6245,\n  \"notes\": \"Handed directly to recipient\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/pod/1/confirm", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "pod", "1", "confirm"] }
          }
        },
        {
          "name": "Verify / Dispute POD (Support / Admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"VERIFIED\",\n  \"verifiedBy\": \"support_amy\",\n  \"notes\": \"Signature matches customer ID record\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/pod/1/verify", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "pod", "1", "verify"] }
          }
        },
        {
          "name": "Get Disputed POD Queue",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/api/pod/disputed", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "pod", "disputed"] }
          }
        }
      ]
    },
